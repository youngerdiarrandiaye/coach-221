# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4200
FRONTEND_ORIGIN=http://127.0.0.1:4200

# Rappels WhatsApp (optionnels)
CRON_SECRET=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Notifications Web Push (rappels de séance). Générer : npx web-push generate-vapid-keys
# La clé privée reste côté serveur uniquement ; ne jamais la committer.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Saisie vocale : compréhension par IA côté serveur (facultatif). Sans clé, un analyseur à règles répond.
# La clé reste côté serveur uniquement ; ne jamais la committer. Modèle par défaut : claude-haiku-4-5.
# ANTHROPIC_API_KEY=
# VOICE_MODEL=

# Limitation de débit (facultatif). Mettre 1 UNIQUEMENT pour des essais automatisés (tests navigateur) ; jamais en production.
# RATE_LIMIT_DISABLED=1

# Génération des photos d'ambiance (node scripts/generate-photos.mjs). Clé côté poste de travail uniquement ; ne jamais la committer.
# OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1
