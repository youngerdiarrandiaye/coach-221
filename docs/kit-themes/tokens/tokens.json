{
  "name": "CoachSen",
  "version": "1.0",
  "font": { "family": "Plus Jakarta Sans", "weights": [400, 500, 600, 700, 800], "fallback": "Segoe UI, system-ui, sans-serif" },
  "radius": { "card": 22, "field": 14, "pill": 999 },
  "touchTarget": 48,
  "themes": {
    "nuit": {
      "label": "Nuit citron", "mode": "dark", "themeColor": "#0a0a0a",
      "colors": { "bg": "#0a0a0a", "surface": "#121212", "surface2": "#1b1b1b", "surface3": "#252525", "edge": "#2a2a2a", "text": "#f2f2f2", "soft": "#9b9b9b", "accent": "#c8f31d", "onAccent": "#0a0a0a" },
      "gradient": null
    },
    "corail": {
      "label": "Corail", "mode": "light", "themeColor": "#fff4f6",
      "colors": { "bg": "#fbf6f8", "surface": "#ffffff", "surface2": "#f7eef2", "surface3": "#f0e3ea", "edge": "#eadde4", "text": "#1d1620", "soft": "#7d6f78", "accent": "#ff1f6b", "onAccent": "#ffffff" },
      "gradient": "linear-gradient(160deg, #ff1f6b 0%, #ff6a4d 60%, #ff9f43 100%)"
    },
    "lagon": {
      "label": "Lagon", "mode": "dark", "themeColor": "#0c0d0e",
      "colors": { "bg": "#0c0d0e", "surface": "#161819", "surface2": "#1e2123", "surface3": "#272b2d", "edge": "#2c3133", "text": "#f2f5f6", "soft": "#8f9c9f", "accent": "#5fc9d2", "onAccent": "#062a2e" },
      "gradient": "linear-gradient(160deg, #3b8a92 0%, #2b6870 100%)"
    }
  },
  "pdf": {
    "note": "Les PDF gardent un fond blanc dans tous les thèmes : seuls le bandeau d'en-tête, l'accent et les gris changent (voir code/pdf-palette.ts).",
    "nuit": { "header": "#0a0a0a", "accent": "#c8f31d", "onAccent": "#0a0a0a" },
    "corail": { "header": "#ff1f6b", "accent": "#ff1f6b", "edge": "#ff9f43", "onAccent": "#ffffff" },
    "lagon": { "header": "#0c0d0e", "accent": "#5fc9d2", "onAccent": "#062a2e" }
  }
}
